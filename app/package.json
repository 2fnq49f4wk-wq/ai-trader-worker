{
  "name": "lux-app",
  "private": true,
  "version": "0.2.0",
  "description": "LUX 네이티브 앱 껍데기(Capacitor) — 화면은 워커 사이트를 그대로 띄운다(사이트를 고치면 앱도 바뀜)",
  "scripts": {
    "assets": "capacitor-assets generate --android --iconBackgroundColor '#000000' --iconBackgroundColorDark '#000000' --splashBackgroundColor '#000000' --splashBackgroundColorDark '#000000'",
    "android:debug": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/status-bar": "8.0.4",
    "@capacitor/splash-screen": "8.0.2",
    "@capgo/capacitor-native-biometric": "8.9.1"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3"
  }
}
